# ===== Server =====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# Session secret (change in production, >= 32 random chars)
SESSION_SECRET=change-this-secret-key-to-a-long-random-string

# ===== Database =====
# sqlite (development). Production: set DB_DRIVER=postgres and DATABASE_URL
DB_DRIVER=sqlite
DB_FILE=./data/app.db
# DATABASE_URL=postgres://user:pass@localhost:5432/affiliate

# ===== AI (Local Ollama, OpenAI-compatible) =====
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:12000/v1
OLLAMA_MODEL=llama3.1:8b
# Ollama does not need a real key. Placeholder only. NEVER put real secrets here.
OLLAMA_API_KEY=ollama
AI_TIMEOUT_MS=180000
AI_MODE=LOCAL_ONLY

# ===== Initial admin bootstrap (used ONLY when the users table is empty; never sent to the browser) =====
# Change the password immediately after first login (Settings > 管理者アカウント).
# If ADMIN_PASSWORD is left empty, a strong random password is generated once and printed to the server console.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=change-this-password
# Optional demo accounts (editor/viewer) with random one-time passwords printed to console. Default: false
SEED_DEMO_USERS=false
# Optional: cap max_tokens per AI request (0 = no cap). Set e.g. 700 on slow CPU-only machines.
AI_MAX_TOKENS=0
