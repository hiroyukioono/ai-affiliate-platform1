{
  "name": "ai-affiliate-platform",
  "version": "1.0.0",
  "description": "AI-powered affiliate website generation, operation, analytics and improvement platform (Local Ollama / llama3.1:8b)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --no-warnings --watch src/server.js",
    "start": "node --no-warnings src/server.js",
    "db:init": "node --no-warnings src/db/init.js",
    "db:seed": "node --no-warnings src/db/seed.js",
    "db:reset": "node --no-warnings src/db/reset.js",
    "test": "node --no-warnings --test tests/unit.test.js",
    "test:e2e": "node --no-warnings tests/e2e.test.js",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "license": "MIT"
}
